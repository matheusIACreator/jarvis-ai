# Copy to .env and fill in real values locally. Never commit .env.
ANTHROPIC_API_KEY=your-anthropic-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Optional; defaults to George (mature British male).
ELEVENLABS_VOICE_ID=your-voice-id
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
STARTUP_AUDIO_PATH=assets/audio/startup.mp3
# Optional: seconds of the startup music to play (fades out); 0 plays the whole file.
STARTUP_AUDIO_SECONDS=10
# Optional: seconds to skip at the start of the music.
STARTUP_AUDIO_START=0
# Optional: minimum clap loudness (0-1). Lower it if claps are missed, raise it on false wakes.
CLAP_MIN_PEAK=0.08
# Optional speech-to-text settings (faster-whisper).
WHISPER_MODEL=small
WHISPER_LANGUAGE=en
